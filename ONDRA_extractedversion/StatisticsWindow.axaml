<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FinanceManager.Views.StatisticsWindow"
        Title="Statistiky"
        Width="820" Height="620"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">

  <Grid RowDefinitions="Auto,*" Margin="12">

    <TextBlock Grid.Row="0" Text="📊 Statistiky" FontSize="22" FontWeight="Bold"
               Foreground="#1E293B" Margin="6,0,0,8"/>

    <TabControl Grid.Row="1">

      <!-- ── Tab 1: Overview ── -->
      <TabItem Header="Přehled">
        <ScrollViewer>
          <StackPanel Spacing="0" Margin="4">

            <!-- Summary row -->
            <Grid ColumnDefinitions="*,*,*">
              <Border Classes="card" Grid.Column="0">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                  <TextBlock Text="Celkové příjmy" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="TotalIncomeText" FontSize="24" FontWeight="Bold"
                             Foreground="#16A34A" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border Classes="card" Grid.Column="1">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                  <TextBlock Text="Celkové výdaje" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="TotalExpensesText" FontSize="24" FontWeight="Bold"
                             Foreground="#DC2626" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border Classes="card" Grid.Column="2">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                  <TextBlock Text="Zůstatek" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="BalanceText" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="BalanceStatusText" FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Monthly breakdown table -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Přehled po měsících" Classes="sectionHeader"/>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="Měsíc" FontWeight="Bold" Foreground="#475569"/>
                  <TextBlock Grid.Column="1" Text="Příjmy" FontWeight="Bold" Foreground="#475569" Width="120" TextAlignment="Right"/>
                  <TextBlock Grid.Column="2" Text="Výdaje" FontWeight="Bold" Foreground="#475569" Width="120" TextAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="Bilance" FontWeight="Bold" Foreground="#475569" Width="120" TextAlignment="Right"/>
                </Grid>
                <Separator/>
                <ItemsControl x:Name="MonthlyList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding MonthLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding IncomeText}" Width="120"
                                   TextAlignment="Right" Foreground="#16A34A" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{Binding ExpenseText}" Width="120"
                                   TextAlignment="Right" Foreground="#DC2626" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="{Binding BalanceText}" Width="120"
                                   TextAlignment="Right" Foreground="{Binding BalanceColor}" FontWeight="SemiBold"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Tab 2: Bar chart ── -->
      <TabItem Header="Graf příjmy/výdaje">
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Měsíční příjmy vs výdaje" Classes="sectionHeader"/>
            <Canvas x:Name="BarChart" Height="380" Background="Transparent"/>
            <!-- Legend -->
            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Rectangle Width="16" Height="16" Fill="#4F8EF7" VerticalAlignment="Center"/>
                <TextBlock Text="Příjmy" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Rectangle Width="16" Height="16" Fill="#F87171" VerticalAlignment="Center"/>
                <TextBlock Text="Výdaje" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </TabItem>

      <!-- ── Tab 3: By category ── -->
      <TabItem Header="Podle kategorií">
        <Grid ColumnDefinitions="*,*">
          <Border Classes="card" Grid.Column="0">
            <StackPanel Spacing="8">
              <TextBlock Text="Výdaje podle kategorií" Classes="sectionHeader"/>
              <ItemsControl x:Name="ExpenseCategoryList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Category}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding AmountText}"
                                   Foreground="#DC2626" FontWeight="SemiBold"/>
                      </Grid>
                      <ProgressBar Value="{Binding Percent}" Maximum="100"
                                   Foreground="#F87171" Height="6" CornerRadius="3" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card" Grid.Column="1">
            <StackPanel Spacing="8">
              <TextBlock Text="Příjmy podle kategorií" Classes="sectionHeader"/>
              <ItemsControl x:Name="IncomeCategoryList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Category}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding AmountText}"
                                   Foreground="#16A34A" FontWeight="SemiBold"/>
                      </Grid>
                      <ProgressBar Value="{Binding Percent}" Maximum="100"
                                   Foreground="#4ADE80" Height="6" CornerRadius="3" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

    </TabControl>
  </Grid>
</Window>
