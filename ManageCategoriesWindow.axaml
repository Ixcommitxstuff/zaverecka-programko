<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FinanceManager.Views.ManageCategoriesWindow"
        Title="Správa kategorií"
        Width="400" Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">

  <Border Margin="20" Classes="card">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <TextBlock Grid.Row="0" Text="🏷 Správa kategorií"
                 FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

      <!-- Add new category -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <TextBox Grid.Column="0" x:Name="NewCategoryBox"
                 Watermark="Název nové kategorie" Margin="0,0,8,0"/>
        <Button Grid.Column="1" Classes="primary" Content="Přidat" Click="OnAddCategory"/>
      </Grid>

      <!-- Category list -->
      <ListBox Grid.Row="2" x:Name="CategoryList" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontSize="14"/>
              <Button Grid.Column="1" Content="🗑" Background="Transparent"
                      Foreground="#94A3B8" Tag="{Binding}"
                      Click="OnRemoveCategory"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Error / info text -->
      <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,8,0,0"
                 TextWrapping="Wrap" IsVisible="False"/>
    </Grid>
  </Border>
</Window>
